<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HardwareShopMaui.Pages.ImportItemsPage"
             Title="Import Items">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Import Items from CSV"
                   FontSize="22" FontAttributes="Bold" />
            <Label Text="Pick a .csv file with these columns: Name, Sku, Category, Unit, PurchasePrice, SalePrice, Quantity, LowStockThreshold."
                   FontSize="13" TextColor="Gray" />

            <Button x:Name="DownloadTemplateButton"
                    Text="Download sample template"
                    Clicked="OnDownloadTemplate" />

            <Button x:Name="PickFileButton"
                    Text="Choose CSV file and import"
                    Clicked="OnPickFile" />

            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" />

            <Label x:Name="ResultLabel" FontSize="14" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
