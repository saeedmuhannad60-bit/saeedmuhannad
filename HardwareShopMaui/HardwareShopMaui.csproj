<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android-only so it builds straight to an APK. Add ;net8.0-ios etc. if you want more. -->
		<TargetFramework>net8.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>HardwareShopMaui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- App identity: keep the SAME id as your existing build so it updates, not installs twice. -->
		<ApplicationTitle>Hardware Shop</ApplicationTitle>
		<ApplicationId>com.muhannad.hardwareshop</ApplicationId>

		<!-- Bump these for each release -->
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

		<SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App icon + splash (simple SVGs included in the repo so the build never misses an asset) -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images / fonts / raw assets -->
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**\*.*" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- If Visual Studio complains about a version, let it pick the version that matches
		     your installed .NET MAUI workload (right-click solution > Manage NuGet Packages). -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="8.0.91" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.91" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
	</ItemGroup>

</Project>
